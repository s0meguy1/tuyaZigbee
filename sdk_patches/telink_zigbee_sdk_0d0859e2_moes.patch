+/* MOES PATCH (vendored SDK, 2026-08-28, build 16): every NV flash address
+ * is derived from a runtime module id, and sector numbers come from values
+ * read back out of the sector headers themselves. Stock macros turn ANY
+ * garbage into a real flash address anywhere on the chip: on the bench, a
+ * crash-looping image with corrupted state drove these macros with garbage
+ * arguments and programmed ~100 KB of 1->0 bit damage across its own
+ * application region, bricking the module until a wired reflash
+ * (bughunt/build15_runaway_cascade.md). Hardening, applied at the macro
+ * layer so every derivation site is covered:
+ *  - moes_nv_module_id_checked(): a module id outside the enum parks the
+ *    CPU in a volatile spin instead of computing an address. The armed
+ *    watchdog then resets the chip and flash stays untouched - a visible,
+ *    recoverable failure. Legitimate callers pass compile-time ids and
+ *    can never trip this.
+ *  - moes_nv_sect_no_checked(): sector numbers parsed from (possibly
+ *    corrupted) headers are clamped into range, so a torn header can at
+ *    worst redirect an access within the module's own NV area.
+ */
+#define MOES_NV_MODULE_SECTOR_NUM				(2)
+
+static inline u16 moes_nv_module_id_checked(u16 id){
+	if(id > NV_MODULE_KEYPAIR){
+		volatile u32 moes_nv_halt = 0;
+		while(!moes_nv_halt){
+			moes_nv_halt = 0;
+		}
+	}
+	return id;
+}
+
+static inline u8 moes_nv_sect_no_checked(u8 sectNo){
+	return (sectNo < MOES_NV_MODULE_SECTOR_NUM) ? sectNo : (u8)(MOES_NV_MODULE_SECTOR_NUM - 1);
+}
+
+#if(FLASH_CAP_SIZE_1M || FLASH_CAP_SIZE_2M || FLASH_CAP_SIZE_4M)
