  * @brief     This function servers to set the spi wait.
  * @param[in] none
  * @return    none
+ *
+ * Vendored-SDK patch (2026-08-15): bound the busy poll. The stock loop is
+ * unbounded and runs with global IRQs disabled inside every flash operation
+ * (flash.c:108/146); if FLD_MSPI_BUSY sticks, the CPU spins forever and never
+ * reaches the caller's irq_restore(). MSPI_WAIT_MAX_ITER is ~2-5 ms at 48 MHz,
+ * roughly 1000x the longest legitimate per-byte MSPI transaction. On timeout
+ * fall out so the caller restores IRQs: NV torn-write recovery handles a failed
+ * op, and the watchdog reset path catches a true hardware wedge.
  */
+#define MSPI_WAIT_MAX_ITER		20000u
 _attribute_ram_code_sec_ static inline void mspi_wait(void){
-	while(reg_mspi_ctrl & FLD_MSPI_BUSY)
-		;
+	unsigned int iter = MSPI_WAIT_MAX_ITER;
+	while((reg_mspi_ctrl & FLD_MSPI_BUSY) && iter){
+		--iter;
+	}
 }
 
