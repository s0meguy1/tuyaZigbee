+#define NV_SECTOR_SIZE(id)						((moes_nv_module_id_checked(id) == NV_MODULE_KEYPAIR) ? (4 * FLASH_SECTOR_SIZE) : FLASH_SECTOR_SIZE)
+#define MODULE_INFO_SIZE(id)					((moes_nv_module_id_checked(id) == NV_MODULE_OTA || moes_nv_module_id_checked(id) == NV_MODULE_KEYPAIR || moes_nv_module_id_checked(id) == NV_MODULE_ADDRESS_TABLE) ? ((moes_nv_module_id_checked(id) == NV_MODULE_KEYPAIR) ? (12*FLASH_PAGE_SIZE) : (4*FLASH_PAGE_SIZE)) : (2*FLASH_PAGE_SIZE))
+#else
+#define MODULES_START_ADDR(id)					((moes_nv_module_id_checked(id) < 6) ? (NV_BASE_ADDRESS + FLASH_SECTOR_SIZE * (2 * moes_nv_module_id_checked(id))) : (NV_BASE_ADDRESS2 + FLASH_SECTOR_SIZE * (2 * (moes_nv_module_id_checked(id)-6))))
+#define NV_SECTOR_SIZE(id)						((moes_nv_module_id_checked(id) == NV_MODULE_KEYPAIR) ?  (2 * FLASH_SECTOR_SIZE) : FLASH_SECTOR_SIZE)
+#define MODULE_INFO_SIZE(id)					((moes_nv_module_id_checked(id) == NV_MODULE_OTA || moes_nv_module_id_checked(id) == NV_MODULE_KEYPAIR || moes_nv_module_id_checked(id) == NV_MODULE_ADDRESS_TABLE) ? (4*FLASH_PAGE_SIZE) : (2*FLASH_PAGE_SIZE))
+#endif
+
+#define MODULE_SECTOR_NUM						(2)
+
+#define MODULE_IDX_SIZE(id)						(MODULE_INFO_SIZE(id) - sizeof(nv_sect_info_t))
+#define MODULE_SECT_START(id, sectNo)   		(MODULES_START_ADDR(id) + moes_nv_sect_no_checked(sectNo) * (NV_SECTOR_SIZE(id)))
+#define MODULE_SECT_END(id, sectNo)     		(MODULES_START_ADDR(id) + (moes_nv_sect_no_checked(sectNo) + 1) * (NV_SECTOR_SIZE(id)))
+#define MODULE_IDX_START(id, sectNo)    		(MODULE_SECT_START(id, sectNo) + sizeof(nv_sect_info_t))
+#define MODULE_IDX_NUM(id)    					(MODULE_IDX_SIZE(id) / (sizeof(nv_info_idx_t)))
