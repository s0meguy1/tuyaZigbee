+ *          WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ *          See the License for the specific language governing permissions and
+ *          limitations under the License.
+ *
+ *******************************************************************************************************/
+
+#include "zb_common.h"
+
+/* MOES PATCH (vendored SDK, 2026): the TS0505B light arrives over the air
+ * and first runs at 0x8000 under the stock Tuya bootloader. Move to the
+ * no-bootloader dual-bank scheme before anything else - RAM code only
+ * (see light/moes_otaScheme.c). Guarded so other targets are unaffected. */
+/* MOES: the no-bootloader dual-bank migration is NOT used in v1 (we keep
+ * the stock Tuya bootloader). Enabling it also requires main() itself to
+ * live in .ram_code, since under a bootloader the image executes at an
+ * offset it was not linked for. */
+#if defined(MOES_NOBOOT_MIGRATION)
+extern void ensure_correct_ota_scheme(void);
+#endif
+
+/*
+ * main:
+ * */
+int main(void){
+#if defined(MOES_NOBOOT_MIGRATION)
+	ensure_correct_ota_scheme();   /* resets if it migrates - never returns then */
+#endif
+
+	startup_state_e state = drv_platform_init();
+
+#if (MODULE_WATCHDOG_ENABLE && MOES_BOOT_WATCHDOG_ENABLE)
+	/* MOES PATCH (vendored SDK, 2026-08-28, build 15): start a long boot
+	 * watchdog after drv_platform_init() returns and BEFORE user_init(). Stock
+	 * order is: user_init() first, then drv_enable_irq() and the 600 ms runtime
+	 * watchdog. The bench rf_setTrxState freeze was observed with brownout/
+	 * silicon confounders, not as firmware proof of that path. This addresses
+	 * equivalent software forward-progress stalls only while Timer2 and its
+	 * clock remain functional; it cannot recover a frozen timer/SRAM domain.
+	 * wd_set_interval_ms() needs the running system clock. Tightened to the
+	 * normal interval only after MOES_BOOT_WATCHDOG_SETTLE_MS of runtime -
+	 * see below and light/app_cfg.h. */
+	drv_wd_setInterval(MOES_BOOT_WATCHDOG_BOOT_MS);
+	drv_wd_start();
+#endif
+
+	u8 isRetention = (state == SYSTEM_DEEP_RETENTION) ? 1 : 0;
+
+#if (MODULE_WATCHDOG_ENABLE && MOES_BOOT_WATCHDOG_ENABLE)
+	/* MOES PATCH (build 16): re-prime the boot window before each init
+	 * phase, so time spent in os_init() cannot eat into user_init()'s
+	 * coverage (and vice versa). */
+	drv_wd_clear();
+#endif
+
+	os_init(isRetention);
+
+#if (MODULE_WATCHDOG_ENABLE && MOES_BOOT_WATCHDOG_ENABLE)
+	drv_wd_clear();
+#endif
+
+#if 0
+	extern void moduleTest_start(void);
+	moduleTest_start();
+#else
+
+	extern void user_init(bool isRetention);
+	user_init(isRetention);
+
+	drv_enable_irq();
+
+#if (MODULE_WATCHDOG_ENABLE)
+	/* MOES PATCH (build 16): do NOT tighten to the 600 ms runtime interval
+	 * here. Build 15 tightened immediately after user_init() returned; on
+	 * the bench the first post-boot cycles (reporting/binding NV
+	 * normalization after a configure pass) then ran under the tight
+	 * window, a mid-sequence reset corrupted NV state, and the resulting
+	 * cascade ended with the firmware programming ~100 KB of bit damage
+	 * over its own application flash (bughunt/build15_runaway_cascade.md).
+	 * Keep the long boot interval for MOES_BOOT_WATCHDOG_SETTLE_MS of
+	 * runtime (see light/app_cfg.h), then tighten inside the loop. With
+	 * MOES_BOOT_WATCHDOG_ENABLE off this is exactly the stock sequence. */
+#if (MOES_BOOT_WATCHDOG_ENABLE)
+	drv_wd_clear();
+	u32 moesWdBootTick = clock_time();
+	u8 moesWdTightened = 0;
+#else
+	drv_wd_clear();
+	drv_wd_setInterval(600);
+    drv_wd_start();
+#endif
+#endif
+
+#if VOLTAGE_DETECT_ENABLE
+    u32 tick = clock_time();
+#endif
+
+	while(1){
+#if VOLTAGE_DETECT_ENABLE
+		if(clock_time_exceed(tick, 200 * 1000)){
+			voltage_detect(0);
+			tick = clock_time();
+		}
+#endif
+
+#if defined(MCU_CORE_B92)
+		drv_vbusWatchdogClose();
+#endif
+
+    	ev_main();
+
+#if (MODULE_WATCHDOG_ENABLE)
+		drv_wd_clear();
+#endif
+
+		tl_zbTaskProcedure();
+
+#if	(MODULE_WATCHDOG_ENABLE)
+		drv_wd_clear();
+#endif
+
+#if (MODULE_WATCHDOG_ENABLE && MOES_BOOT_WATCHDOG_ENABLE)
+		if(!moesWdTightened && clock_time_exceed(moesWdBootTick, MOES_BOOT_WATCHDOG_SETTLE_MS * 1000)){
+			moesWdTightened = 1;
+			drv_wd_clear();
+			drv_wd_setInterval(600);
+			drv_wd_start();
+		}
+#endif
+	}
+
+#endif
+
+	return 0;
+}
+
