# build dir
build/*
build-bench/
# Every out-of-tree build directory (build-35, build-36, build-37, build-exp...).
# Firmware binaries are distributed as GitHub Releases with published sha256s,
# never committed: a rebuild of identical sources differs in its date code and
# CRC, so a committed binary would not match what is actually deployed.
build-*/

#cache dir
.cache/*

# Prerequisites
*.d
__pycache__/

# Object files
*.o
*.ko
*.obj
*.elf

# Linker output
*.ilk
*.map
*.exp

# Precompiled Headers
*.gch
*.pch

# Libraries
*.lib
*.a
*.la
*.lo

# Shared objects (inc. Windows DLLs)
*.dll
*.so
*.so.*
*.dylib

# Executables
*.exe
*.out
*.app
*.i*86
*.x86_64
*.hex

# Debug files
*.dSYM/
*.su
*.idb
*.pdb

# Kernel Module Compile Results
*.mod*
*.cmd
.tmp_versions/
modules.order
Module.symvers
Mkfile.old
dkms.conf

# host test binary
tools/rescue_hosttest/test_rescue
tools/bench_selftest_hosttest/test_bench_selftest
tools/eui_hosttest/test_eui
tools/nvheal_hosttest/test_nvheal
tools/build19_hosttest/test_level

# Local MOES bench records and captures. Existing tracked history is not hidden
# by these rules; sanitize it explicitly before publishing.
HANDOVER*.md
AI_*.md
tools/OTA_STALL_PLAYBOOK.md
field-artifacts/private*/
field-artifacts/*capture*/
field-artifacts/*.log
field-artifacts/*.bin
# field-artifacts/ is a LOCAL staging area, not a distribution channel.
# Nothing binary in it is publishable: a raw network map carries every device
# address on the mesh, and firmware ships as a GitHub Release with a published
# sha256 rather than as a committed blob. Only the README here is tracked.
field-artifacts/*.zigbee
field-artifacts/*.json
# Do not add full local EUI-64s to artifact names. The 16 character pattern is
# deliberately narrow so public, non-identity firmware names stay trackable.
field-artifacts/*0x[0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F]*.zigbee
build-23/
build-24/
build-25/
build-26/
build-27/
build-28/
build-29/
build-30/
build-31/
build-32/
build-33/
build-34/
